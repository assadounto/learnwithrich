# Start PostgreSQL with `npm run db:up`, then apply committed migrations.
DATABASE_URL=postgresql://learnwithrich:local-development-only@127.0.0.1:54329/learnwithrich
# Create this separate database before running integration checks.
TEST_DATABASE_URL=postgresql://learnwithrich:local-development-only@127.0.0.1:54329/learnwithrich_test

# Owned LearnWithRich creator identity. Register the callback URL below in your Google OAuth client.
# LWR_AUTH_URL=http://localhost:3000
# LWR_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# LWR_GOOGLE_CLIENT_ID=your-owned-google-client-id
# LWR_GOOGLE_CLIENT_SECRET=your-owned-google-client-secret
# LWR_ADMIN_ENABLED=false

# S3 compatible private media bucket (Block Public Access enabled)
S3_REGION=us-east-1
S3_BUCKET=learnwithrich-media
S3_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET
# Optional for S3-compatible storage (for example Cloudflare R2/MinIO)
# S3_ENDPOINT_URL=https://s3.example.com
# S3_FORCE_PATH_STYLE=false

# Paystack secret. Use test keys for staging.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_SECRET
# Optional webhook signing secret from Paystack dashboard > Developers > API configuration.
# Without it, webhook signatures are verified using PAYSTACK_SECRET_KEY.
# PAYSTACK_WEBHOOK_SECRET=whsec_REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET

# Optional: trusted country-code header set by the edge proxy. Defaults to cf-ipcountry.
# ANALYTICS_COUNTRY_HEADER=cf-ipcountry
