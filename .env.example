# Same Google WEB OAuth client ID accepted by Xonbay's GOOGLE_CLIENT_ID.
# Add the final LearnWithRich origin and http://localhost:3000 in Google Console.
GOOGLE_CLIENT_ID=490165269615-jkafd28indpein5klbdtj4ggm5r8pf7l.apps.googleusercontent.com
XONBAY_API_URL=https://api.xonbay.com
# Verified public shop: Learn With Rich (handle learnwithrich), ID 46.
XONBAY_SHOP_ID=46
XONBAY_SHOP_HANDLE=learnwithrich
# Exact public origin; required behind a reverse proxy for origin checks.
APP_URL=http://localhost:3000

# Optional until the owned catalog replaces the existing integration.
# Start the local DB with npm run db:up, then copy this into your local .env.
DATABASE_URL=postgresql://learnwithrich:local-development-only@127.0.0.1:54329/learnwithrich
# Create a separate DB named learnwithrich_test before integration tests.
TEST_DATABASE_URL=postgresql://learnwithrich:local-development-only@127.0.0.1:54329/learnwithrich_test

# Owned LearnWithRich identity (independent of the legacy Xonbay Google flow).
# Create a dedicated Google web OAuth client and register:
# http://localhost:3000/api/identity/callback/google
# and the same /api/identity/callback/google path on your production origin.
# LWR_AUTH_URL=http://localhost:3000
# LWR_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# LWR_GOOGLE_CLIENT_ID=your-owned-google-client-id
# LWR_GOOGLE_CLIENT_SECRET=your-owned-google-client-secret
