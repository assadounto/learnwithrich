LWR_AUTH_URL=https://learnwithrich.com
LWR_AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
LWR_GOOGLE_CLIENT_ID=REPLACE_WITH_OWNED_GOOGLE_CLIENT_ID
LWR_GOOGLE_CLIENT_SECRET=REPLACE_WITH_OWNED_GOOGLE_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://learnwithrich:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/learnwithrich

# Set true after deploying migrations and configuring Google OAuth. MFA is mandatory for studio access.
LWR_ADMIN_ENABLED=false

# S3-compatible bucket with Block Public Access enabled and a narrowly scoped IAM key
S3_REGION=us-east-1
S3_BUCKET=learnwithrich-media
S3_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET
# Optional when using an S3-compatible service such as R2
# S3_ENDPOINT_URL=https://s3.example.com
# S3_FORCE_PATH_STYLE=false

# Paystack test/live secret and webhook signing secret
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_SECRET
PAYSTACK_WEBHOOK_SECRET=whsec_REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
