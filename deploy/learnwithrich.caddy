
# BEGIN LearnWithRich
learnwithrich.com {
  encode zstd gzip
  reverse_proxy learnwithrich-web:3000
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

www.learnwithrich.com {
  redir https://learnwithrich.com{uri} permanent
}
# END LearnWithRich
