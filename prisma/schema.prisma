generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResourceType {
  PROJECT
  ARTICLE
  COURSE
  PATH
  LESSON
  DOWNLOAD
  BOOK
  GUIDE
  ILLUSTRATION
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceAccess {
  PUBLIC
  FREE_ACCOUNT
  PAID
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  @@map("purchase_status")
}

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
  @@map("moderation_status")
}

enum ServiceRequestStatus {
  NEW
  REVIEWING
  QUOTED
  PAYMENT_PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  @@map("service_request_status")
}

enum ServicePaymentPurpose {
  QUOTE
  REVISION
  @@map("service_payment_purpose")
}

enum ServiceRevisionStatus {
  REQUESTED
  PAYMENT_PENDING
  DRAFT
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  @@map("service_revision_status")
}

model Resource {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique @db.VarChar(120)
  type        ResourceType
  title       String         @db.VarChar(180)
  summary     String         @default("") @db.VarChar(2000)
  coverUrl    String?        @map("cover_url") @db.VarChar(2048)
  status      ResourceStatus @default(DRAFT)
  access      ResourceAccess @default(PUBLIC)
  priceMinor  Int            @default(0) @map("price_minor")
  currency    String         @default("GHS") @db.VarChar(3)
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int            @default(0)
  audits      ResourceAudit[]
  content     ResourceContent?
  tags        ResourceTag[]
  sections    ResourceSection[]
  items       ResourceItem[] @relation("Collection")
  includedIn  ResourceItem[] @relation("Child")
  media       ResourceMedia[]
  purchases   Purchase[]
  savedBy     SavedResource[]

  @@index([status, publishedAt, id])
  @@index([type, status, publishedAt])
  @@map("resources")
}

// Private by default: catalog projections never automatically include this row.
model ResourceContent {
  details      Json     @default("{}")
  resourceId   String   @id @map("resource_id") @db.Uuid
  bodyMarkdown String   @default("") @map("body_markdown") @db.Text
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_content")
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(60)
  resources ResourceTag[]

  @@map("tags")
}

model ResourceTag {
  resourceId String   @map("resource_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId, resourceId])
  @@map("resource_tags")
}

model ResourceSection {
  id         String         @id @default(uuid()) @db.Uuid
  resourceId String         @map("resource_id") @db.Uuid
  title      String         @db.VarChar(180)
  position   Int
  resource   Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  items      ResourceItem[]

  @@unique([id, resourceId])
  @@unique([resourceId, position])
  @@map("resource_sections")
}

// A shared resource can appear in many collections; order belongs to the link.
model ResourceItem {
  id           String           @id @default(uuid()) @db.Uuid
  collectionId String           @map("collection_id") @db.Uuid
  resourceId   String           @map("resource_id") @db.Uuid
  sectionId    String?          @map("section_id") @db.Uuid
  position     Int
  collection   Resource         @relation("Collection", fields: [collectionId], references: [id], onDelete: Cascade)
  resource     Resource         @relation("Child", fields: [resourceId], references: [id], onDelete: Restrict)
  section      ResourceSection? @relation(fields: [sectionId, collectionId], references: [id, resourceId], onDelete: NoAction)

  @@unique([collectionId, resourceId])
  @@unique([collectionId, position])
  @@index([resourceId])
  @@index([sectionId, collectionId])
  @@map("resource_items")
}

enum UserRole {
  LEARNER
  OWNER
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          UserRole  @default(LEARNER)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  mfa           OwnerMfa?
  sessions      Session[]
  accounts      Account[]
  audits        ResourceAudit[]
  resourceTokens ResourceApiToken[]
  purchases     Purchase[]
  savedResources SavedResource[]
  reviews       Review[]
  serviceRequests ServiceRequest[]
  servicePayments ServicePayment[]

  @@map("users")
}

model ResourceApiToken {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id")
  label     String    @db.VarChar(80)
  digest    String    @unique @db.Char(64)
  hint      String    @db.Char(8)
  canEdit   Boolean   @default(false) @map("can_edit")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("resource_api_tokens")
}

model OwnerMfa {
  userId           String    @id @map("user_id")
  secretCiphertext String?   @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  pendingSessionId String?   @map("pending_session_id")
  pendingExpiresAt DateTime? @map("pending_expires_at") @db.Timestamptz(3)
  lastUsedStep     Int       @default(-1) @map("last_used_step")
  recoveryHashes  String[]  @default([]) @map("recovery_hashes")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_mfa")
}

model Session {
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String   @id
  accountId             String   @map("account_id")
  providerId            String   @map("provider_id")
  userId                String   @map("user_id")
  accessToken           String?  @map("access_token")
  refreshToken          String?  @map("refresh_token")
  idToken               String?  @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model ResourceAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id")
  resourceId String   @map("resource_id") @db.Uuid
  action     String   @db.VarChar(30)
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([resourceId, version])
  @@index([actorId, createdAt])
  @@map("resource_audits")
}

model HomepageSettings {
  id                 Int      @id @default(1)
  sections           Json     @default("[]")
  heroPreset         String   @default("CLASSIC") @map("hero_preset") @db.VarChar(20)
  heroImageAssetId   String?  @map("hero_image_asset_id") @db.Uuid
  heroVideoAssetId   String?  @map("hero_video_asset_id") @db.Uuid
  heroMobileImageAssetId String? @map("hero_mobile_image_asset_id") @db.Uuid
  heroMobileVideoAssetId String? @map("hero_mobile_video_asset_id") @db.Uuid
  heroVideoEnabled Boolean @default(false) @map("hero_video_enabled")
  heroDelaySeconds   Int      @default(5) @map("hero_delay_seconds")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_settings")
}

model MediaFolder {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  assets    MediaAsset[]

  @@map("media_folders")
}

model MediaAsset {
  id           String       @id @default(uuid()) @db.Uuid
  folderId     String?      @map("folder_id") @db.Uuid
  originalName String       @map("original_name") @db.VarChar(180)
  storageKey   String       @unique @map("storage_key") @db.VarChar(255)
  mimeType     String       @map("mime_type") @db.VarChar(120)
  sizeBytes    Int          @map("size_bytes")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  resources    ResourceMedia[]
  serviceRevisionFiles ServiceRevisionFile[]
  serviceRequestFiles ServiceRequestFile[]
  communityGuestbookPhotos GuestbookEntry[] @relation("GuestbookPhoto")
  communityReviewPhotos Review[] @relation("ReviewPhoto")

  @@index([folderId, createdAt])
  @@map("media_assets")
}

model ResourceMedia {
  id           String     @id @default(uuid()) @db.Uuid
  resourceId   String     @map("resource_id") @db.Uuid
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  title        String     @db.VarChar(180)
  priceMinor   Int        @default(0) @map("price_minor")
  position     Int
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  purchases    Purchase[]

  @@unique([resourceId, mediaAssetId])
  @@unique([resourceId, position])
  @@index([mediaAssetId])
  @@map("resource_media")
}

model SavedResource {
  userId     String   @map("user_id")
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@index([resourceId])
  @@map("saved_resources")
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id")
  resourceId     String?        @map("resource_id") @db.Uuid
  resourceMediaId String?       @map("resource_media_id") @db.Uuid
  reference      String         @unique @db.VarChar(100)
  checkoutUrl    String?        @map("checkout_url") @db.Text
  amountMinor    Int            @map("amount_minor")
  currency       String         @db.VarChar(3)
  status         PurchaseStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz(3)
  paystackId     String?        @map("paystack_id") @db.VarChar(80)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource       Resource?      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  resourceMedia  ResourceMedia? @relation(fields: [resourceMediaId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([resourceId, userId, status])
  @@index([resourceMediaId, userId, status])
  @@map("purchases")
}

model GuestbookEntry {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(100)
  email     String?          @db.VarChar(254)
  title     String?          @db.VarChar(120)
  country   String?          @db.VarChar(80)
  imageAssetId String?       @map("image_asset_id") @db.Uuid
  message   String           @db.VarChar(800)
  status    ModerationStatus @default(PENDING)
  ipHash    String?          @map("ip_hash") @db.VarChar(64)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  imageAsset MediaAsset?     @relation("GuestbookPhoto", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([imageAssetId])
  @@map("guestbook_entries")
}

model Review {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @unique @map("user_id")
  displayName String           @map("display_name") @db.VarChar(100)
  title       String?          @db.VarChar(120)
  country     String?          @db.VarChar(80)
  imageAssetId String?         @map("image_asset_id") @db.Uuid
  message     String           @db.VarChar(1000)
  rating      Int              @default(5)
  status      ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageAsset  MediaAsset?      @relation("ReviewPhoto", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([imageAssetId])
  @@map("reviews")
}

model ServiceRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String?              @map("user_id")
  requesterName   String               @map("requester_name") @db.VarChar(120)
  requesterEmail  String               @map("requester_email") @db.VarChar(254)
  requesterPhone  String               @map("requester_phone") @db.VarChar(32)
  serviceType     String               @map("service_type") @db.VarChar(60)
  description     String               @db.Text
  budgetMinor     Int?                 @map("budget_minor")
  currency        String               @default("GHS") @db.VarChar(3)
  timeline        String?              @db.VarChar(160)
  status          ServiceRequestStatus @default(NEW)
  quoteMinor      Int?                 @map("quote_minor")
  quoteNote       String?              @map("quote_note") @db.Text
  quotedAt        DateTime?            @map("quoted_at") @db.Timestamptz(3)
  includedRevisions Int                @default(1) @map("included_revisions")
  usedIncludedRevisions Int            @default(0) @map("used_included_revisions")
  extraRevisionPriceMinor Int          @default(0) @map("extra_revision_price_minor")
  ipHash          String?              @map("ip_hash") @db.VarChar(64)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments        ServicePayment[]
  revisions       ServiceRevision[]
  files           ServiceRequestFile[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("service_requests")
}

model ServicePayment {
  id               String                @id @default(uuid()) @db.Uuid
  serviceRequestId String                @map("service_request_id") @db.Uuid
  serviceRevisionId String?              @unique @map("service_revision_id") @db.Uuid
  userId           String                @map("user_id")
  purpose          ServicePaymentPurpose
  reference        String                @unique @db.VarChar(100)
  checkoutUrl      String?               @map("checkout_url") @db.Text
  amountMinor      Int                   @map("amount_minor")
  currency         String                @db.VarChar(3)
  status           PurchaseStatus        @default(PENDING)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(3)
  paystackId       String?               @map("paystack_id") @db.VarChar(80)
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  revision         ServiceRevision?      @relation(fields: [serviceRevisionId], references: [id], onDelete: SetNull)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([serviceRequestId, purpose, status])
  @@map("service_payments")
}

model ServiceRequestFile {
  serviceRequestId String        @map("service_request_id") @db.Uuid
  mediaAssetId     String        @map("media_asset_id") @db.Uuid
  position         Int
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([serviceRequestId, mediaAssetId])
  @@unique([serviceRequestId, position])
  @@index([mediaAssetId])
  @@map("service_request_files")
}

model ServiceRevision {
  id               String               @id @default(uuid()) @db.Uuid
  serviceRequestId String               @map("service_request_id") @db.Uuid
  revisionNumber   Int                  @map("revision_number")
  status           ServiceRevisionStatus @default(REQUESTED)
  requesterNote    String?              @map("requester_note") @db.Text
  title            String               @db.VarChar(180)
  summary          String               @default("") @db.Text
  changesMade      String               @default("") @map("changes_made") @db.Text
  requesterFeedback String?             @map("requester_feedback") @db.Text
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt      DateTime?            @map("submitted_at") @db.Timestamptz(3)
  approvedAt       DateTime?            @map("approved_at") @db.Timestamptz(3)
  serviceRequest   ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  files            ServiceRevisionFile[]
  payment          ServicePayment?

  @@unique([serviceRequestId, revisionNumber])
  @@index([serviceRequestId, status, revisionNumber])
  @@map("service_revisions")
}

model ServiceRevisionFile {
  revisionId  String          @map("revision_id") @db.Uuid
  mediaAssetId String         @map("media_asset_id") @db.Uuid
  position    Int
  revision    ServiceRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([revisionId, mediaAssetId])
  @@unique([revisionId, position])
  @@map("service_revision_files")
}

model NewsletterSignup {
  email      String    @id @db.VarChar(254)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("newsletter_signups")
}

model ProjectIdea {
  slug        String         @id @db.VarChar(120)
  title       String         @db.VarChar(180)
  discipline  String         @db.VarChar(32)
  abstract    String         @db.VarChar(3000)
  tags        String[]
  status      ResourceStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, discipline, title])
  @@map("project_ideas")
}
