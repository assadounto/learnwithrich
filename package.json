{
  "name": "learnwithrich",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "test:db": "node scripts/test-database.mjs",
    "resources": "tsx scripts/resources.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "test:admin-http": "tsx scripts/test-admin-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.26",
    "dotenv": "18.0.10",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
